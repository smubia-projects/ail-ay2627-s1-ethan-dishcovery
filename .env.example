# Dishcovery API (Cloud Run). Copy to .env (gitignored) and fill in, then upload it as the
# repo's DOTENV secret: gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-ethan-dishcovery < .env
# There is no database, LLM or rate limiter: the catalog is read from the data/ files baked into the image.

# Comma-separated browser origins allowed to call the API (no spaces needed).
# Local dev: http://localhost:5173. Production: the Vercel URL, e.g. https://ail-ay2627-s1-ethan-dishcovery.vercel.app
CORS_ORIGINS=http://localhost:5173

# "true" serves GET /api/demo/coupons and shows the demo-coupon screens; "false" hides them.
DEMO_COUPONS=false

# Optional. Cloud Run injects PORT itself (8080); only set it for local runs.
# PORT=8080

# Optional. Folder holding venues/, published/, upload/ and coupons/. The Docker image sets
# DATA_DIR=/app/data; locally it defaults to the repo's data/ folder.
# DATA_DIR=
